) %>% filter(tq <= 1991 * 4 + 2) %>% filter(product %in% c("256k", "1Mb", "4Mb"))
)
m_slope <- feols(
log_price ~ i(product, time) +
i(product, post) +
i(product, I(time * post), ref = "256k") +
I(time * post),
data = df %>% mutate(
tq = year * 4 + quarter,
treated = as.integer(
product %in% c("256K", "1Mb", "4Mb")
),
post = as.integer(tq >= 1986 * 4 + 3),
time = tq - (1986 * 4 + 2),
log_price = log(price)
) %>% filter(tq <= 1991 * 4 + 2) %>% filter(product %in% c("256K", "1Mb", "4Mb"))
)
summary(m_slope)
m_slope <- feols(
log_price ~ i(product, time) +
i(product, post) +
i(product, I(time * post), ref = "256k") +
I(time * post),
data = df %>% mutate(
tq = year * 4 + quarter,
treated = as.integer(
product %in% c("256K", "1Mb", "64K")
),
post = as.integer(tq >= 1986 * 4 + 3),
time = tq - (1986 * 4 + 2),
log_price = log(price)
) %>% filter(tq <= 1991 * 4 + 2) %>% filter(product %in% c("256K", "1Mb", "64K"))
)
summary(m_slope)
m_slope <- feols(
log_price ~
0 + product +
product:time +
product:post +
prod_256K:break_time +
prod_1Mb:break_time +
prod_64K:break_time,
data = df %>% mutate(
tq = year * 4 + quarter,
treated = as.integer(
product %in% c("256K", "1Mb", "64K")
),
post = as.integer(tq >= 1986 * 4 + 3),
time = tq - (1986 * 4 + 2),
log_price = log(price)) %>%
mutate(
break_time = time * post,
prod_256K = as.integer(product == "256K"),
prod_1Mb  = as.integer(product == "1Mb"),
prod_64K  = as.integer(product == "64K")
) %>% filter(tq <= 1991 * 4 + 2) %>% filter(product %in% c("256K", "1Mb", "64K"))
)
summary(m_slope)
df_plot <- df %>%
mutate(
tq = year * 4 + quarter,
product = factor(product, levels = c("64K", "256K", "1Mb", "4Mb")),
log_price = log(price)
) %>%
filter(year >= 1983, tq <= 1991 * 4 + 2) %>%
group_by(product) %>%
mutate(
base_price = log_price[tq == 1986 * 4 + 2][1],
price_index = 100 * exp(log_price - base_price)
) %>%
ungroup() %>%
filter(!is.na(base_price))
ggplot(df_plot, aes(x = tq, y = price_index, color = product)) +
annotate(
"rect",
xmin = 1986 * 4 + 2.5, xmax = 1991 * 4 + 2.5,
ymin = -Inf, ymax = Inf,
fill = "grey80", alpha = 0.25
) +
geom_line(linewidth = 0.9) +
geom_vline(
xintercept = 1986 * 4 + 2.5,
linetype = "dashed", color = "grey35"
) +
scale_x_continuous(
breaks = seq(1983 * 4, 1991 * 4, by = 4),
labels = 1983:1991
) +
labs(
x = NULL,
y = "Price index (1986 Q2 = 100)",
color = "DRAM generation",
title = "DRAM prices around the 1986 U.S. price-floor agreement",
subtitle = "Dashed line: August 1986 implementation; shaded area: policy period"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
ggplot(df_plot, aes(x = tq, y = log(price_index), color = product)) +
