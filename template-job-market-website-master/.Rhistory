df_did <- df %>%
mutate(
tq = year * 4 + quarter,
treated = as.integer(product %in% c("256K", "1Mb", "4Mb")),
post = as.integer(tq >= 1986 * 4 + 3),
log_price = log(price)
) %>%
filter(
tq >= 1980 * 4 + 1,
tq <= 1991 * 4 + 2
)
m_did <- feols(
log_price ~ treated:post | product + tq,
data = df_did
)
summary(m_did)
m_did_product <- feols(
log_price ~ i(product, post, ref = "64K") | product + tq,
data = df_did %>%
filter(product %in% c("64K", "256K", "1Mb"))
)
etable(m_did, m_did_product)
